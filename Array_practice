// Ques2. Find the length of an array manually

public class Ques2 {
    public static void main(String[] args){
        int[] num = {1,2,3,4};
        int count = 0;
        for(int i=0; i<num.length;i++){
            count++;
        }
        System.out.println(count);
    }
}
