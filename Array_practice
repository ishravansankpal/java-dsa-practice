//Count even numbers in an array.

public class Ques11 {
    public static void main(String[] args) {
        int[] arr = {2,3,1,5,6,4};
        int even = 0;

        for(int i=0; i < arr.length; i++){
            if(arr[i]%2 == 0){
                even += 1;
            }
        }
        System.out.println(even);
    }
    
}
