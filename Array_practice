//Ques6. Calculate the average

public class Ques6 {
    public static void main(String[] args){
        int[] num = {3,2,6,1,5,1};
        int sum=0;
        for(int i=0; i<num.length;i++){
            sum += num[i];
        }
        int avg = sum / num.length;

        System.out.println(avg);      
    }  
}
