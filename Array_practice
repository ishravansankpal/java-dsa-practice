//Find the sum of all array elements.

public class Ques4 {
    public static void main(String[] args){
        int[] arr = {3,2,1,5,6,7};
        int sum = 0;

        for(int i=0; i < arr.length; i++){
            sum += arr[i];
        }
        System.out.println("Sum of array elements: " + sum);

    } 
}
