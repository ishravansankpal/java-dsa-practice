//Ques4. Find the smallest element

public class Ques4 {
    public static void main(String[] args) {
        int[] num = {2,5,1,3,6};
        int min = num[0];
        for(int i=0; i<num.length;i++){
            if(min > num[i]){
                min = num[i];
            }
        }
        System.out.println(min);
    }
}
