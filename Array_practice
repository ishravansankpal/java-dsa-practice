//Ques5. Calculate the sum of all elements

public class Ques5 {
    public static void main(String[] args) {
        int[] num = {4,3,8,2};
        int sum = 0;
        for(int i=0; i<num.length;i++){
            sum += num[i];
        }
        System.out.println(sum);
    }
}
