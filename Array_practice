//Ques7. Count even numbers

public class Ques7 {
    public static void main(String[] args) {
        int[] num = {3,2,6,2,0,1};
        int even = 0;
        for(int i=0; i<num.length; i++){
            if(num[i]%2 == 0){
                even++;
            }
        }
        System.out.println(even);
    }
    
}
