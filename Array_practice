//Ques9. Search for a given element (linear search)

public class Ques9 {
    public static void main(String[] args) {
        int[] num = {2, 5, 0, 1};
        int target = 1;
        boolean found = false;

        for (int i = 0; i < num.length; i++) {
            if (num[i] == target) {
                found = true;
                break; 
            }
        }

        System.out.println(found);
    }
}





