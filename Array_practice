//Print array elements in reverse order.

public class Ques2 {
    public static void main(String[] args){
        int[] arr = {4,1,7,8,2};

        for(int i = arr.length-1; i>=0; i--){
            System.out.print(arr[i] + " ");
        }
    }
}
