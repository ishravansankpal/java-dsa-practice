//Find the average of array elements.

public class Ques5 {
    public static void main(String[] args) {
        int[] arr = {2, 1, 3, 0};
        int sum = 0;
        
        for (int i = 0; i < arr.length; i++) {
            sum += arr[i];
        }
        double avg = (double) sum / arr.length;

        System.out.print(avg);
    }
}
