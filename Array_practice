//Ques 19. Check if array is sorted

public class Ques19 {
    public static void main(String[] args) {

        int[] a = {1, 2, 3};

        boolean sorted = true;

        for(int i = 0; i < a.length - 1; i++) {

            if(a[i] > a[i+1]) {
                sorted = false;
                break;
            }
        }

        if(sorted) {
            System.out.println("Array is sorted");
        } else {
            System.out.println("Array is not sorted");
        }
    }
}
