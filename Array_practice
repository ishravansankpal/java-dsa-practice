//Find the length of an array manually.

public class Ques3 {
    public static void main(String[] args){
        int[] arr = {4,2,7,8,9};
        int count = 0;

        for(int i=0; i < arr.length; i++){
            count += 1;
        }
        System.out.println("Total Length of Array is: " + count);
    }
}
