// Ques16. Swap first and last element

public class Ques16 {
    public static void main(String[] args) {
        int[] num = {1, 4, 2, 0};

        int first = num[0];
        int last = num[num.length - 1];

        num[0] = last;
        num[num.length - 1] = first;

        for (int i = 0; i < num.length; i++) {
            System.out.println(num[i]);
        }
    }
}
