//Ques17. Find second largest element

public class Ques17 {
    public static void main(String[] args) {
        int[] arr = {12, 35, 1, 10, 34, 1};

        int first = arr[0];
        int second = -1;

        for (int i = 1; i < arr.length; i++) {
            if (arr[i] > first) {
                second = first;
                first = arr[i];
            } else if (arr[i] < first && arr[i] > second) {
                second = arr[i];
            }
        }

        System.out.println("Second largest: " + second);  // 34
    }
}
