//Ques 7.  Count special characters

public class Ques7 {
    public static void main(String[] args) {

        String word = "@_Shrav_#$";
        int count = 0;

        for(int i = 0; i < word.length(); i++) {
            char ch = word.charAt(i);

            if((ch < 'A' || ch > 'Z') &&
            (ch < 'a' || ch > 'z') &&
            (ch < '0' || ch > '9')) {

                count++;
            }
        }

        System.out.println("Special characters: " + count);
    }
}
