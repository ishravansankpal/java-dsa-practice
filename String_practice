//Ques 2. Count characters

public class Ques2 {
    public static void main(String[] args) {
        int count = 0;

        String word = "Rahul";

        for(int i=0; i < word.length(); i++ ){
                count += 1;
            } 
             System.out.println("Count: " + count);
        }
       
}
